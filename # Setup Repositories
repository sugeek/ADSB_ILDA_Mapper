### 1. `src/node_madmapper.py`

```python
import math
import time
import requests
import argparse
from pythonosc import udp_client

parser = argparse.ArgumentParser(description='MadMapper Laser Safety Node')
parser.add_argument('--mode', choices=['mask', 'kill'], default='mask',
                    help="Choose 'mask' for dynamic blanking or 'kill' to cut master opacity.")
args = parser.parse_args()

MM_IP = "127.0.0.1"
MM_PORT = 8000
PROJ_LAT = 40.786400
PROJ_LON = -119.204500
PROJ_ALT_M = 1200.0
PROJ_AZIMUTH = 0.0
PROJ_H_FOV = 60.0
PROJ_V_FOV = 45.0
WATCHDOG_TIMEOUT = 1.0
MAX_NOHD_METERS = 3500.0

osc_client = udp_client.SimpleUDPClient(MM_IP, MM_PORT)

def wgs84_to_local_enu(lat, lon, alt_m, ref_lat, ref_lon, ref_alt_m):
    x_east = (lon - ref_lon) * 111320.0 * math.cos(math.radians(ref_lat))
    y_north = (lat - ref_lat) * 110574.0
    z_up = alt_m - ref_alt_m
    return x_east, y_north, z_up

def enu_to_spherical(x, y, z):
    h_dist = math.sqrt(x**2 + y**2)
    azimuth = (math.degrees(math.atan2(x, y)) + 360) % 360
    elevation = math.degrees(math.atan2(z, h_dist))
    return azimuth, elevation

def spherical_to_texture_uv(az, el, p_az, h_fov, v_fov):
    az_diff = (az - p_az + 540) % 360 - 180
    if abs(az_diff) > (h_fov / 2.0) or abs(el) > (v_fov / 2.0):
        return None
    u = (az_diff + (h_fov / 2.0)) / h_fov
    v = (el + (v_fov / 2.0)) / v_fov
    return max(0.0, min(1.0, u)), max(0.0, min(1.0, v))

last_valid_data_time = time.time()
print(f"Starting MadMapper Node. Mode: {args.mode.upper()}")

while True:
    current_time = time.time()
    target_in_zone = False
    
    try:
        response = requests.get("http://127.0.0.1:8080/data/aircraft.json", timeout=0.5)
        target = response.json().get("aircraft", [{}])[0]
        
        if "lat" in target:
            last_valid_data_time = current_time
            x, y, z = wgs84_to_local_enu(target["lat"], target["lon"], target.get("alt_baro", 0) * 0.3048, PROJ_LAT, PROJ_LON, PROJ_ALT_M)
            slant_range = math.sqrt(x**2 + y**2 + z**2)
            
            if slant_range <= MAX_NOHD_METERS:
                az, el = enu_to_spherical(x, y, z)
                uv = spherical_to_texture_uv(az, el, PROJ_AZIMUTH, PROJ_H_FOV, PROJ_V_FOV)
                
                if uv:
                    target_in_zone = True
                    if args.mode == 'mask':
                        u, v = uv
                        p = 0.05
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_1_x", max(0.0, u - p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_1_y", max(0.0, v - p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_2_x", min(1.0, u + p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_2_y", max(0.0, v - p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_3_x", min(1.0, u + p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_3_y", min(1.0, v + p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_4_x", max(0.0, u - p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/quad/point_4_y", min(1.0, v + p))
                        osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/visible", 1)
                else:
                    osc_client.send_message("/surfaces/Dynamic_Blanking_Zone/visible", 0)
    except Exception:
        pass
        
    if (current_time - last_valid_data_time > WATCHDOG_TIMEOUT) or (target_in_zone and args.mode == 'kill'):
        osc_client.send_message("/master_opacity", 0.0)
    else:
        osc_client.send_message("/master_opacity", 1.0)
        
    time.sleep(0.05)

